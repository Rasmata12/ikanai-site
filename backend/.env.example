# Port d'écoute de l'API
PORT=4000

# Origine autorisée pour les requêtes CORS (l'URL du site en développement ou en production).
# Plusieurs origines séparées par une virgule sont acceptées.
FRONTEND_ORIGIN=http://localhost:5173

# Chemin du fichier SQLite, utilisé par défaut (créé automatiquement si absent).
DATABASE_PATH=./data/ikanai-site.db

# Pour la production : renseignez plutôt DATABASE_URL avec l'adresse d'une base
# PostgreSQL (Supabase, Neon, Render...). Dès qu'elle est renseignée, elle remplace
# automatiquement SQLite — inutile de modifier le code. Laissez vide en développement.
# Exemple : postgresql://utilisateur:motdepasse@hote:5432/nom_de_la_base
DATABASE_URL=

# --- Envoi d'e-mails ---
# Si SMTP_HOST n'est pas renseigné, les messages sont uniquement enregistrés en base
# et l'API répond quand même avec succès : aucun envoi d'e-mail n'est tenté.
#
# Exemple avec Gmail (voir le README pour la marche à suivre complète) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ikanai.marketing@gmail.com
# Mot de passe d'application Gmail (16 caractères, sans espaces) — jamais le mot de
# passe habituel du compte. Voir le README pour savoir où le générer.
SMTP_PASSWORD=
# Adresse d'expédition affichée sur les e-mails envoyés par l'API.
MAIL_FROM="IKAN AI <ikanai.marketing@gmail.com>"
# Adresse interne qui reçoit chaque message de contact.
MAIL_TO=ikanai.marketing@gmail.com

# Nombre maximum de requêtes autorisées par adresse IP, par fenêtre de 15 minutes.
RATE_LIMIT_MAX=20

# --- Administration de la newsletter ---
# Jeton secret pour accéder à /admin (composer et envoyer une diffusion aux
# abonnés). Choisissez une longue chaîne aléatoire, gardez-la pour vous —
# quiconque la connaît peut envoyer un e-mail à toute votre liste.
# Exemple pour en générer une : openssl rand -hex 24
# Sans cette valeur, /admin et les routes /api/admin/* restent désactivées.
ADMIN_TOKEN=

# Adresse publique de cette API, utilisée pour construire le lien de
# désinscription dans les e-mails groupés. En local, la valeur par défaut
# suffit. En production, indiquez l'URL réelle de l'API déployée.
# Exemple : https://ikanai-api.onrender.com
PUBLIC_API_URL=http://localhost:4000
